<Window x:Class="NEKO_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="N.E.K.O. - Fubuki Edition" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ChatScroller" Grid.Row="0" Margin="10,10,10,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="ChatHistory" VerticalAlignment="Bottom">
                <TextBlock Text="Load AI..." Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,20"/>
            </StackPanel>
            
        </ScrollViewer>
        <ComboBox x:Name="PersonaSelector" 
      Grid.Row="0" 
      HorizontalAlignment="Right" 
      VerticalAlignment="Top" 
      Width="150" 
      Margin="0,10,20,0"
      Background="#1E1E1E"
      Foreground="Black"
      BorderBrush="#555555"
      SelectionChanged="PersonaSelector_SelectionChanged">
            <ComboBoxItem Content="🦊 Fubuki" IsSelected="True"/>
            <ComboBoxItem Content="🐟 Sameko Saba"/>
        </ComboBox>

        <Border Grid.Row="1" Margin="20" Background="#CC151515" CornerRadius="25" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox" Grid.Column="1" 
                         Background="Transparent" 
                         Foreground="White" 
                         BorderThickness="0"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                         Margin="10,5"
                         CaretBrush="Cyan"
                         KeyDown="InputBox_KeyDown"
                         Text=""/>

                <Button x:Name="SendButton" Grid.Column="2" 
                        Content="➤" 
                        Width="40" Height="40"
                        Background="#00BCD4" 
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="18"
                        BorderThickness="0"
                        Click="SendButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>